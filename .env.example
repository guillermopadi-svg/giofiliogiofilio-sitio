# ============================================================================
# Gio Filio — Tu espacio ideal
# Variables de entorno de ejemplo
#
# Copia este archivo como `.env.local` y llena los valores.
# NUNCA subas `.env.local` al repositorio.
#
# NOTA sobre esta entrega: el sitio estático NO lee estas variables.
# Para la demo, la configuración del cliente vive en `assets/js/config.js`.
# Este archivo documenta la configuración necesaria al migrar a Next.js.
# ============================================================================

# ----------------------------------------------------------------- GENERAL
NEXT_PUBLIC_SITE_URL="https://giofilio.com"
NEXT_PUBLIC_SITE_NAME="Gio Filio — Tu espacio ideal"
NEXT_PUBLIC_DEFAULT_LOCALE="es-MX"
NEXT_PUBLIC_CITY="Ciudad de México"

# --------------------------------------------------------------- EASYBROKER
# Esta sí se usa hoy: la lee _generador/sync_easybroker.py para importar el
# inventario real de Gio Filio (cuenta propia, no la de otra inmobiliaria).
# Nunca la expongas en el navegador — EasyBroker exige consumo solo server-side.
EASYBROKER_API_KEY=""

# ------------------------------------------------------------------- MAPAS
# Google Maps JavaScript API. Restringe la key por referente HTTP.
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Opcional: Geocoding y Places para autocomplete real de direcciones (server-side)
GOOGLE_MAPS_SERVER_KEY=""
GOOGLE_MAPS_MAP_ID=""

# Alternativa: Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_MAPBOX_STYLE="mapbox://styles/mapbox/light-v11"

# --------------------------------------------------------------- SUPABASE
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Solo servidor. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=""
# Conexión directa para migraciones
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres"

# ------------------------------------------------------- ALMACENAMIENTO
SUPABASE_STORAGE_BUCKET="propiedades"
# Alternativa: Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --------------------------------------------------------------- WHATSAPP
# Número en formato internacional sin signos: 52 + LADA + número
NEXT_PUBLIC_WHATSAPP_NUMBER="525512345678"
# WhatsApp Business Cloud API (opcional, para respuestas automáticas)
WHATSAPP_BUSINESS_PHONE_ID=""
WHATSAPP_BUSINESS_TOKEN=""

# --------------------------------------------------------------- ANALÍTICA
NEXT_PUBLIC_GTM_ID=""                 # GTM-XXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""     # G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""          # 1234567890123456
NEXT_PUBLIC_GOOGLE_ADS_ID=""          # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""
# Verificación de propiedad
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=""
# Meta Conversions API (server-side, mejora la atribución)
META_CONVERSIONS_API_TOKEN=""

# --------------------------------------------------------------------- CRM
HUBSPOT_PORTAL_ID=""
HUBSPOT_FORM_GUID=""
HUBSPOT_PRIVATE_APP_TOKEN=""          # Solo servidor
# Endpoint propio que recibe los leads del formulario
NEXT_PUBLIC_LEADS_ENDPOINT="/api/leads"

# ------------------------------------------------------------------ CORREO
RESEND_API_KEY=""
EMAIL_FROM="Gio Filio <hola@giofilio.com>"
EMAIL_NOTIFICACIONES="hola@giofilio.com"

# ------------------------------------------------------------- SEGURIDAD
# Protege los formularios contra spam
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Límite de envíos por IP y por hora
RATE_LIMIT_LEADS_POR_HORA="10"

# ------------------------------------------------------------------ ADMIN
# Acceso al panel de administración de propiedades
ADMIN_ALLOWED_EMAILS="hola@giofilio.com"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://giofilio.com"

# ---------------------------------------------------------------- FEATURES
NEXT_PUBLIC_FEATURE_CUENTAS_USUARIO="false"
NEXT_PUBLIC_FEATURE_ALERTAS_BUSQUEDA="false"
NEXT_PUBLIC_FEATURE_TOUR_VIRTUAL="true"
NEXT_PUBLIC_DATASET_DEMO="true"        # Muestra la barra y los badges de DEMO
